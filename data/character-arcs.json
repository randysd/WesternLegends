        "requiresWorldTags": [],
        "onResolved": [
          {
            "type": "addWorldTag",
            "tag": "prospector_helped"
          },
          {
            "type": "newspaperNote",
            "text": "A Man Near Death was resolved."
          }
        ],
        "onExpired": [
          {
            "type": "addWorldTag",
            "tag": "prospector_abandoned"
          },
          {
            "type": "newspaperNote",
            "text": "A Man Near Death was ignored."
          }
        ]
      },
      {
        "id": "prospector_debt_repaid",
        "type": "storyTrigger",
        "trigger": "trig_purchase_item",
        "title": "Debt Repaid",
        "screenText": "After purchasing/upgrading an Item, gain $20.",
        "assignPlayerColor": "optional",
        "expiresAfterPrimaryTriggers": 6,
        "narrationScript": "[western storyteller][old cowboy][raspy] \"The old prospector steps from the corner and lays coins on the counter. I told ya I would repay kindness.\"",
        "audioFile": "audio/arcs/prospector_debt_repaid.mp3",
        "requiresWorldTags": [
          "prospector_helped"
        ],
        "onResolved": [
          {
            "type": "addWorldTag",
            "tag": "prospector_repaid"
          },
          {
            "type": "newspaperNote",
            "text": "Debt Repaid was resolved."
          }
        ],
        "onExpired": [
          {
            "type": "addWorldTag",
            "tag": "prospector_missed_repay"
          },
          {
            "type": "newspaperNote",
            "text": "Debt Repaid was ignored."
          }
        ]
      },
      {
        "id": "prospector_bandit_reveal",
        "type": "instantEvent",
        "trigger": "trig_defeat_bandit",
        "title": "The Man You Left Behind",
        "screenText": "Place 2 Bandits in the current space. Fight both simultaneously. Choose the result afterward.",
        "requiresWorldTags": [
          "prospector_abandoned"
        ],
        "narrationScript": "[western storyteller][old cowboy][raspy] \"The outlaw falls and removes his hat. Beneath the grime you recognize the prospector you left in the dust. He whistles, and two more bandits crawl from the rocks.\"",
        "audioFile": "audio/arcs/prospector_bandit_reveal.mp3",
        "effects": [
          {
            "type": "spawn_bandits_current_space",
            "count": 2
          },
          {
            "type": "simultaneous_npc_fight",
            "npc": "bandit",
            "count": 2
          }
        ],
        "resultButtons": [
          {
            "label": "Prospector Captured",
            "effects": [
              {
                "type": "addWorldTag",
                "tag": "prospector_captured"
              }
            ]
          },
          {
            "label": "Prospector Escaped",
            "effects": [
              {
                "type": "addWorldTag",
                "tag": "prospector_escaped"
              }
            ]
          },
          {
            "label": "Player Defeated",
            "effects": [
              {
                "type": "addWorldTag",
                "tag": "prospector_victorious"
              }
            ]
          }
        ]
      }
    ]
  },
