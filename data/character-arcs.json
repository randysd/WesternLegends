    "startTrigger": "trig_begin_prospect",
    "baseWeight": 10,
    "nodes": [
      {
        "id": "prospector_intro",
        "type": "storyTrigger",
        "trigger": "trig_begin_prospect",
        "title": "A Man Near Death",
        "screenText": "End your turn at any Saloon to gain $20.",
        "assignPlayerColor": "optional",
        "expiresAfterPrimaryTriggers": 6,
        "narrationScript": "[western storyteller][old cowboy][raspy] \"A half-starved prospector stumbles from the sagebrush, clutching a leather poke. He offers twenty dollars for a drink and a ride to town.\"",
