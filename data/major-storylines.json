        "type": "storyTrigger",
        "trigger": "trig_travel_rail",
        "title": "Surveyors Arrive",
        "screenText": "End your turn at any Rail Station to gain $20 and Railroad Progress +1.",
        "assignPlayerColor": "optional",
        "expiresAfterPrimaryTriggers": 6,
        "narrationScript": "[western storyteller][old cowboy][raspy] \"Surveyors arrive with chains, stakes, and the dangerous idea that tomorrow can be measured.\"",
        "audioFile": "audio/arcs/rail_surveyors.mp3",
        "requiresWorldTags": [],
        "onResolved": [
          {
            "type": "addWorldTag",
            "tag": "rail_surveyed"
          },
          {
            "type": "newspaperNote",
            "text": "Surveyors Arrive was resolved."
          }
        ],
        "onExpired": [
