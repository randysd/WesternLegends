      {
        "id": "rail_grand_opening",
        "type": "worldEvent",
        "title": "Grand Opening",
        "requiresCounters": [
          {
            "counter": "railroad_progress",
            "gte": 3
          }
        ],
        "screenText": "For the next 6 primary triggers, Travel by Rail costs $0.",
