      "setupInstructions": [
        {
          "id": "board_setup",
          "title": "Buzzard Gulch Board Setup",
          "summary": "Build the compact Border Town play area.",
          "steps": [
            {
              "text": "Place the Buzzard Gulch board on top of the Western Legends board sideways so the Rail Station edge is just above the Legendary Point track and the left edge is just right of the Story deck spaces.",
              "id": "place_the_buzzard_gulch_board_on_top_of_the_western_lege",
              "visual": {
                "focusMode": "full",
                "revealBoards": [
                  "ante-up-frontier"
                ],
                "placements": []
              }
            },
            {
              "text": "Fold under the rightmost section of the train board extension and place it just above the Buzzard Gulch board with its left edge just right of the Wanted track.",
              "id": "fold_under_the_rightmost_section_of_the_train_board_exte",
              "visual": {
                "focusMode": "full",
                "revealBoards": [
                  "ante-up-gambler"
                ],
                "placements": []
              }
            },
            {
              "text": "Place the train miniature at the Buzzard Gulch Rail Station.",
              "id": "place_the_train_miniature_at_the_buzzard_gulch_rail_stat",
              "visual": {
                "focus": "buzzard-gulch-rail",
                "placements": [
                  {
                    "asset": "train",
                    "target": "buzzard-gulch-rail"
                  }
                ]
              }
            },
            {
              "text": "Place the Bandit Hideout tokens/buildings in the spaces marked with a red Bandit Hideout icon.",
              "id": "place_the_bandit_hideout_tokens_buildings_in_the_spaces_",
              "visual": {
                "focusTargets": [
                  "buzzard-gulch-outlaw-camp",
                  "frontier-value-6"
                ],
                "placements": [
                  {
                    "asset": "bandit",
                    "target": "buzzard-gulch-outlaw-camp"
                  },
                  {
                    "asset": "bandit",
                    "target": "frontier-value-6",
                    "pointIndex": 0
                  },
                  {
                    "asset": "bandit",
                    "target": "frontier-value-6",
                    "pointIndex": 1
                  }
                ]
              }
            },
            {
              "text": "Place the Mine tokens/buildings in the spaces marked with a yellow Mine icon.",
              "id": "place_the_mine_tokens_buildings_in_the_spaces_marked_wit",
              "visual": {
                "focusTargets": [
                  "mountain-pass-a",
                  "mountain-pass-c"
                ],
                "placements": [
                  {
                    "asset": "mine-marker",
                    "target": "mountain-pass-a"
                  },
                  {
                    "asset": "mine-marker",
                    "target": "mountain-pass-c"
                  }
                ]
              }
            },
            {
              "text": "Each player sets aside 1 cube near their player mat as a Homestead marker.",
              "id": "each_player_sets_aside_1_cube_near_their_player_mat_as_a",
              "visual": {
                "focus": "player-area",
                "placements": [
                  {
                    "asset": "player-cube",
                    "target": "player-area",
                    "label": "Homestead"
                  }
                ]
              }
            },
            {
              "text": "Ignore character Starting Locations. After determining turn order normally, players choose any unoccupied space on the board as their starting space.",
              "id": "ignore_character_starting_locations_after_determining_tu",
              "visual": {
                "focusMode": "full",
                "placements": [
                  {
                    "asset": "player-marker",
                    "target": "player-area",
                    "label": "Choose Start"
                  }
                ]
              }
            }
          ]
        }
